# Copy this file to Cred.env (same folder) and fill in your own values.
# Cred.env is git-ignored -- never commit it, never paste real keys here
# in this .example file, and never send it over Slack/email as a plain
# attachment. Each operator should have their own Cred.env, created from
# this template, not a copy of someone else's.

# Required -- Anthropic Claude powers report writing.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for real-data grounding (HTAG suburb market data -- median
# price, growth, yield, clearance rate, etc). Without this, every report
# falls back to the AI's own estimates for those figures, clearly labelled
# as estimates. Ask whoever manages the HTAG account for a key.
HTAG_API_KEY=your-htag-key-here

# Optional -- overrides the default Claude model (claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional -- customer enquiry log goes to this Google Sheet instead of
# the local SPG_Customer_Intake_Form.xlsx when BOTH of these are set.
# Leave both blank to just use the local Excel file (the default).
# GOOGLE_SHEETS_ID=the-sheet-id-from-its-url
# GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json

# Optional -- name shown in the "Assigned To" column of a recorded enquiry.
# ASSIGNED_TO=Your Name
